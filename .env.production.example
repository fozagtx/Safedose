# Copy to .env.production and fill in. Generate each secret with:
#   openssl rand -base64 32
DB_PASSWORD=
SERVICE_SECRET=
EMAIL_PEPPER=
JWT_KEY=
JWT_REFRESH_PEPPER=

# Public host names (no scheme). Production config assumes HTTPS on 443.
API_HOST=api.onedose.example.com
WEB_HOST=onedose.example.com
INSIGHTS_HOST=insights.onedose.example.com

# Sign-up emails. Leave empty on Serverpod Cloud. Self-hosted, either set a
# Serverpod Cloud email key or switch lib/server.dart to
# EmailIdpConfigFromPasswords with your own mail provider.
SCLOUD_EMAIL_KEY=

# true = 1 and 2 minute escalation stages, shown as "Demo timings" in the app.
ONEDOSE_DEMO=false
